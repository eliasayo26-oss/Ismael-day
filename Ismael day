      </button>

      <div id="successMessage">
        Il rapporto è stato inviato! Ismael è fiero di te.
      </div>
    </section>

  </form>
</main>

<footer>
  Progetto segreto di Ismael © 2026<br>
  Creato con affetto, una rana e una quantità esagerata di entusiasmo.
</footer>

<script>
const compliments = [
  "Zahra, hai una mente artistica e un modo tutto tuo di vedere il mondo.",
  "Sei una persona interessante. E no, non è un complimento di circostanza.",
  "La tua creatività è una cosa preziosa. Non lasciarla in un cassetto.",
  "Hai il diritto di occupare spazio, di parlare, di ridere e di essere te stessa.",
  "Il mondo sarebbe un posto un po' più noioso senza le tue stranezze.",
  "Non devi essere perfetta per essere una persona meravigliosa.",
  "Hai una sensibilità che merita di essere coltivata, non nascosta.",
  "Sei più coraggiosa di quanto probabilmente ti concedi di pensare.",
  "Ismael ha controllato il tuo curriculum: sei ufficialmente una persona fantastica.",
  "Non dimenticare che anche tu meriti la stessa gentilezza che dai agli altri.",
  "Hai un universo nella testa. Ogni tanto apri le finestre e lascialo uscire.",
  "Sei un'opera d'arte in corso. E le opere d'arte non hanno bisogno di fretta."
];

let complimentIndex = 0;

function newCompliment() {
  complimentIndex = (complimentIndex + 1) % compliments.length;
  document.getElementById("complimentText").textContent =
    compliments[complimentIndex];
  makeSparkles();
}

function frogMessage() {
  const messages = [
    "Ciao Zahra! Sono Ismael. Andiamo a conquistare il mondo.",
    "Rana presente. Motivazione discutibile, ma presente.",
    "Non dimenticare di bere acqua. Ordine del direttore.",
    "Sei pronta? Io sono pronto. Anche se non ho le scarpe.",
    "Una missione alla volta, Baby!"
  ];
  alert(messages[Math.floor(Math.random() * messages.length)]);
}

function makeSparkles() {
  const symbols = ["★", "♡", "✿", "✦", "♥"];
  for (let i = 0; i < 12; i++) {
    const s = document.createElement("div");
    s.className = "sparkle";
    s.textContent = symbols[Math.floor(Math.random() * symbols.length)];
    s.style.left = Math.random() * 100 + "vw";
    s.style.top = (50 + Math.random() * 40) + "vh";
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 1100);
  }
}

const checkboxes = document.querySelectorAll(
  '.mission input[type="checkbox"]'
);

const progressBar = document.getElementById("progressBar");
const progressText = document.getElementById("progressText");

function updateProgress() {
  const total = checkboxes.length;
  const completed = [...checkboxes].filter(c => c.checked).length;
  const percentage = (completed / total) * 100;

  progressBar.style.width = percentage + "%";
  progressText.textContent =
    completed + " missioni su " + total + " completate";

  localStorage.setItem("ismael_missions",
    JSON.stringify([...checkboxes].map(c => c.checked)));
}

const savedProgress = JSON.parse(
  localStorage.getItem("ismael_missions") || "[]"
);

checkboxes.forEach((checkbox, index) => {
  checkbox.checked = savedProgress[index] || false;
  checkbox.addEventListener("change", updateProgress);
});

updateProgress();

document.getElementById("missionForm").addEventListener("submit", function(e) {
  const selected = [...document.querySelectorAll(
    'input[name="risposta_lettera"]:checked'
  )];

  if (selected.length === 0) {
    e.preventDefault();
    alert("Zahra, devi scegliere una risposta alla lettera!");
    return;
  }

  const completed = [...checkboxes]
    .filter(c => c.checked)
    .map(c => c.value);

  document.getElementById("progressReport").value =
    completed.length
      ? completed.join(", ")
      : "Nessuna missione contrassegnata come completata.";

  document.getElementById("submissionDate").value =
    new Date().toLocaleString("it-IT");

  const button = document.getElementById("sendButton");
  button.textContent = "Invio in corso...";
  button.disabled = true;
});
</script>

